// ============================================================
// POWER BI DAX MEASURES REPOSITORY (PRODUCTION-READY)
// Best Practice: Create an empty table called "_Measures" and
// add all of these measures inside it.
// ============================================================

// ============================================================
// 1. GOOGLE SEARCH CONSOLE MEASURES
// ============================================================

[Google Clicks] = 
SUM(silver_google_search[clicks])

[Google Impressions] = 
SUM(silver_google_search[impressions])

[Google CTR] = 
DIVIDE([Google Clicks], [Google Impressions], 0)

// Clicks from revealed queries only
[Google Revealed Keyword Clicks] = 
CALCULATE([Google Clicks], NOT(ISBLANK(silver_google_search[query])) && silver_google_search[query] <> "")

// Clicks where Google hid the query due to privacy (query is NULL/BLANK)
[Google Anonymized Clicks] = 
CALCULATE([Google Clicks], ISBLANK(silver_google_search[query]) || silver_google_search[query] = "")

[Google Anonymized Traffic %] = 
DIVIDE([Google Anonymized Clicks], [Google Clicks], 0)

[Google Weighted Avg Position] = 
DIVIDE(
    SUMX(
        FILTER(silver_google_search, NOT(ISBLANK(silver_google_search[query])) && silver_google_search[query] <> ""), 
        silver_google_search[impressions] * silver_google_search[position]
    ),
    CALCULATE([Google Impressions], NOT(ISBLANK(silver_google_search[query])) && silver_google_search[query] <> ""),
    BLANK()
)

[Google Clicks MoM %] = 
VAR PrevMonth = CALCULATE([Google Clicks], DATEADD(Dim_Date[Date], -1, MONTH))
RETURN
DIVIDE([Google Clicks] - PrevMonth, PrevMonth, 0)


// ============================================================
// 2. BING PAGE MEASURES (Site-Wide Landing Page Performance)
// ============================================================

[Bing Page Clicks] = 
SUM(silver_bing_page_search[clicks])

[Bing Page Impressions] = 
SUM(silver_bing_page_search[impressions])

[Bing Page CTR] = 
DIVIDE([Bing Page Clicks], [Bing Page Impressions], 0)

[Bing Page Weighted Avg Position] = 
DIVIDE(
    SUMX(silver_bing_page_search, silver_bing_page_search[impressions] * silver_bing_page_search[avg_position]),
    [Bing Page Impressions],
    BLANK()
)

[Bing Page Clicks MoM %] = 
VAR PrevMonth = CALCULATE([Bing Page Clicks], DATEADD(Dim_Date[Date], -1, MONTH))
RETURN
DIVIDE([Bing Page Clicks] - PrevMonth, PrevMonth, 0)


// ============================================================
// 3. BING QUERY MEASURES (Keyword Performance)
// ============================================================

[Bing Query Clicks] = 
SUM(silver_bing_search[clicks])

[Bing Query Impressions] = 
SUM(silver_bing_search[impressions])

[Bing Query CTR] = 
DIVIDE([Bing Query Clicks], [Bing Query Impressions], 0)

[Bing Query Weighted Avg Position] = 
DIVIDE(
    SUMX(silver_bing_search, silver_bing_search[impressions] * silver_bing_search[avg_position]),
    [Bing Query Impressions],
    BLANK()
)


// ============================================================
// 4. COMBINED EXECUTIVE & BLENDED METRICS (HEAD-TO-HEAD)
// Note: Uses Bing Page Clicks for true complete website traffic comparison
// ============================================================

[Total Search Clicks] = 
[Google Clicks] + [Bing Page Clicks]

[Total Search Impressions] = 
[Google Impressions] + [Bing Page Impressions]

[Blended CTR] = 
DIVIDE([Total Search Clicks], [Total Search Impressions], 0)

[Total Clicks MoM %] = 
VAR PrevMonth = CALCULATE([Total Search Clicks], DATEADD(Dim_Date[Date], -1, MONTH))
RETURN
DIVIDE([Total Search Clicks] - PrevMonth, PrevMonth, 0)

[Google Click Share %] = 
DIVIDE([Google Clicks], [Total Search Clicks], 0)

[Bing Click Share %] = 
DIVIDE([Bing Page Clicks], [Total Search Clicks], 0)


// ============================================================
// 5. ADVANCED SEO OPPORTUNITY INDICATORS
// ============================================================

// High-value opportunity keywords: Striking Distance (Page 2: positions 10-20 with >= 50 impressions)
[Google Striking Distance Flag] = 
IF(
    [Google Weighted Avg Position] >= 10 && [Google Weighted Avg Position] <= 20 && [Google Impressions] >= 50,
    1,
    0
)


// ============================================================
// 6. SNAPSHOT METRICS (LATEST DAY PULSE)
// Disconnected from date slicers — always shows the most recent day
// ============================================================

[Latest Google Clicks] = 
SUM(google_latest[clicks])

[Latest Google Impressions] = 
SUM(google_latest[impressions])

[Latest Bing Clicks] = 
SUM(bing_latest_page[clicks])

[Latest Bing Impressions] = 
SUM(bing_latest_page[impressions])
